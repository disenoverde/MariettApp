rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isCoach() {
      return request.auth != null &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'coach';
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isCoach();
    }

    match /clientes/{clienteId} {
      allow read, write: if isCoach();
      allow read: if request.auth != null &&
                     resource.data.uid_cliente == request.auth.uid;
      allow update: if request.auth != null &&
                       request.resource.data.uid_cliente == request.auth.uid;
    }

    match /historias_salud/{historiaId} {
      allow read, write: if isCoach();
      allow read, write: if request.auth != null &&
                            resource.data.cliente_id != null &&
                            get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.uid_cliente == request.auth.uid;
    }

    match /objetivos/{objetivoId} {
      allow read, write: if isCoach();
      allow read: if request.auth != null &&
                     resource.data.cliente_id != null &&
                     get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.uid_cliente == request.auth.uid;
    }

    match /sesiones/{sesionId} {
      allow read, write: if isCoach();
      allow read: if request.auth != null &&
                     resource.data.cliente_id != null &&
                     resource.data.tipo == 'con_acuerdos' &&
                     get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.uid_cliente == request.auth.uid;
    }

    match /ruedas_bienestar/{ruedaId} {
      allow read, write: if isCoach();
      allow read, create: if request.auth != null;
    }

    match /contratos/{contratoId} {
      allow read, write: if isCoach();
      allow read: if true;
      allow update: if resource.data.estado == 'pendiente_firma';
    }

    match /invitaciones/{invId} {
      allow read, write: if isCoach();
      allow read: if true;
      allow update: if request.auth != null;
    }
  }
}
