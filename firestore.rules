rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isCoach() {
      return request.auth != null &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'coach';
    }

    function isClienteOwner(clienteId) {
      return request.auth != null &&
             get(/databases/$(database)/documents/clientes/$(clienteId)).data.uid_cliente == request.auth.uid;
    }

    function isOwnerViaClienteId() {
      return request.auth != null &&
             resource.data.cliente_id != null &&
             get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.uid_cliente == request.auth.uid;
    }

    // ── Usuarios (roles) ──
    match /usuarios/{uid} {
      allow read, write: if isCoach();
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    // ── Clientes ──
    match /clientes/{clienteId} {
      allow read, write: if isCoach();
      allow read: if request.auth != null &&
                     resource.data.uid_cliente == request.auth.uid;
      allow update: if request.auth != null &&
                       request.resource.data.uid_cliente == request.auth.uid;
    }

    // ── Historia de Salud ──
    match /historias_salud/{historiaId} {
      allow read, write: if isCoach();
      allow read, write: if isOwnerViaClienteId();
    }

    // ── Objetivos ──
    match /objetivos/{objetivoId} {
      allow read, write: if isCoach();
      allow read, write: if isOwnerViaClienteId();
    }

    // ── Sesiones ──
    match /sesiones/{sesionId} {
      allow read, write: if isCoach();
      // Cliente solo ve sesiones con acuerdos (el PDF resultante)
      allow read: if isOwnerViaClienteId() &&
                     resource.data.tipo == 'con_acuerdos';
    }

    // ── Ruedas del Bienestar ──
    match /ruedas_bienestar/{ruedaId} {
      allow read, write: if isCoach();
      allow read, create: if request.auth != null;
      allow update: if request.auth != null &&
                       resource.data.clienteId == request.auth.uid ||
                       !resource.data.bloqueada;
    }

    // ── Contratos ──
    match /contratos/{contratoId} {
      allow read, write: if isCoach();
      allow read: if true;
      allow update: if resource.data.estado == 'pendiente_firma';
    }

    // ── Invitaciones ──
    match /invitaciones/{invId} {
      allow read, write: if isCoach();
      allow read: if true;
      allow update: if request.auth != null;
    }
  }
}
