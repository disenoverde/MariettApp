rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verificar si es coach leyendo desde Firestore
    function isCoach() {
      return request.auth != null &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'coach';
    }

    // Helper: verificar si el cliente es dueño del documento
    function isOwner(clienteId) {
      return request.auth != null &&
             get(/databases/$(database)/documents/clientes/$(clienteId)).data.uid_cliente == request.auth.uid;
    }

    // ── Usuarios (roles) ──
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isCoach();
    }

    // ── Clientes ──
    match /clientes/{clienteId} {
      allow read, write: if isCoach();
      allow read: if request.auth != null &&
                     resource.data.uid_cliente == request.auth.uid;
      allow update: if request.auth != null &&
                       request.resource.data.uid_cliente == request.auth.uid;
    }

    // ── Historias de Salud ──
    match /historias_salud/{historiaId} {
      allow read, write: if isCoach();
      allow read, update: if isOwner(historiaId);
    }

    // ── Objetivos ──
    match /objetivos/{objetivoId} {
      allow read, write: if isCoach();
      allow read: if isOwner(objetivoId);
    }

    // ── Sesiones ──
    match /sesiones/{sesionId} {
      allow read, write: if isCoach();
    }

    // ── Ruedas del Bienestar ──
    match /ruedas_bienestar/{ruedaId} {
      allow read, write: if isCoach();
      allow read, create: if request.auth != null &&
                             request.auth.uid != null;
    }

    // ── Contratos ──
    match /contratos/{contratoId} {
      allow read, write: if isCoach();
      allow read: if true;
      allow update: if resource.data.estado == 'pendiente_firma';
    }

    // ── Invitaciones ──
    match /invitaciones/{invId} {
      allow read, write: if isCoach();
      allow read: if true;
      allow update: if request.auth != null;
    }
  }
}
